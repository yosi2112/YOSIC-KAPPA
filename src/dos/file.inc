; Handle API: eight application-local slots at B0000h, 128 bytes per slot.
; Slot: active/mode/drive/dirLBA/dirOffset/size/position/firstCluster/name[11].
; Scratch 4F00h..4F7Fh; sector COPYBUF, chain SRCCHAIN. Writes are synchronous.
FileField MACRO offset
        LRM R0,[R13+offset]
        PSH R0
        ENDM
FileSmall MACRO value
        ADI R0,RZR,value
        PSH R0
        ENDM
file_reset:
        Const R8,0xB0000
        ADI R9,RZR,8
file_reset_loop:
        SRM RZR,[R8]
        ADI R8,R8,128
        ADI R9,R9,-1
        SRZ R9
        JMP file_reset_loop
        ADI R0,RZR,0
        JMP return_sub
file_has_open:
        Const R8,0xB0000
        ADI R9,RZR,8
file_has_loop:
        LRM R0,[R8]
        SRZ R0
        JMP file_has_yes
        ADI R8,R8,128
        ADI R9,R9,-1
        SRZ R9
        JMP file_has_loop
        ADI R0,RZR,0
        JMP return_sub
file_has_yes:
        ADI R0,RZR,1
        JMP return_sub
file_dispatch:
        Const R13,4f00h
        Const R0,40000h
        SRM R0,[R13+116]
        Const R0,46000h
        SRM R0,[R13+120]
        Const R0,64000h
        SRM R0,[R13+124]
        SRM RZR,[R13+52]
        SRM R1,[R13+112]
        Const R0,13fe4h
        SRM RZR,[R0]
        ADI R0,R1,-20h
        SNZ R0
        JMP file_open
        ADI R0,R1,-21h
        SNZ R0
        JMP file_close
        Call file_find
        SRZ R0
        JMP file_io_result
        LRM R0,[R13+4]
        LRM R1,[R13+112]
        ADI R1,R1,-22h
        SRZ R1
        JMP file_write_mode
        ADI R0,R0,-1
        SNZ R0
        JMP file_io_denied
        JMP file_io_start
file_write_mode:
        SNZ R0
        JMP file_io_denied
file_io_start:
        Call file_load
        SRZ R0
        JMP file_io_result
        LRM R0,[RZR+4d08h]
        SRM R0,[R13+48]
        LRM R0,[RZR+4d0ch]
        SRM R0,[R13+44]
        SNZ R0
        JMP file_io_success
        Call file_buffer
        SRZ R0
        JMP file_io_result
        LRM R0,[R13+112]
        ADI R0,R0,-23h
        SNZ R0
        JMP file_write_validate
        LRM R0,[R13+20]
        LRM R1,[R13+24]
        SUB R0,R0,R1
        LRM R1,[R13+44]
        SUB R2,R0,R1
        Const R3,80000000h
        ANL R2,R2,R3
        SRZ R2
        SRM R0,[R13+44]
        JMP file_io_loop
file_write_validate:
        LRM R8,[R13+48]
        LRM R9,[R13+44]
file_byte_loop:
        LRM R0,[R8]
        ADI R1,RZR,255
        ANL R1,R0,R1
        SUB R0,R0,R1
        SRZ R0
        JMP file_io_parameter
        ADI R8,R8,4
        ADI R9,R9,-1
        SRZ R9
        JMP file_byte_loop
file_io_loop:
        LRM R0,[R13+52]
        LRM R1,[R13+44]
        SUB R0,R0,R1
        SNZ R0
        JMP file_io_success
        LRM R0,[R13+24]
        ADI R1,RZR,512
        Call core_div
        SRM R0,[R13+56]
        SRM R1,[R13+60]
        LRM R0,[R13+32]
        LRM R0,[R0+36]
        ADI R1,RZR,1
        SUB R1,R0,R1
        SNZ R1
        JMP file_cluster_sector_ready
        LRM R0,[R13+56]
        LRM R1,[R13+32]
        LRM R1,[R1+36]
        Call core_div
        SRM R0,[R13+56]
        SRM R1,[R13+76]
        JMP file_cluster_sector_done
file_cluster_sector_ready:
        SRM RZR,[R13+76]
file_cluster_sector_done:
        SRM RZR,[R13+72]
        LRM R1,[R13+40]
        SUB R2,R0,R1
        Const R3,80000000h
        ANL R2,R2,R3
        SNZ R2
        JMP file_new_sector
        ADD R0,R0,R0
        ADD R0,R0,R0
        LRM R1,[R13+124]
        ADD R0,R0,R1
        LRM R0,[R0]
        SRM R0,[R13+64]
        FileSmall 0
        Call file_sector
        ADI SP,SP,4
        SRZ R0
        JMP file_io_fault
        JMP file_chunk
file_new_sector:
        LRM R0,[R13+112]
        ADI R0,R0,-23h
        SRZ R0
        JMP file_io_data
        Call core_allocate
        SNZ R0
        JMP file_io_disk_error
        SRM R0,[R13+64]
        ADI R0,RZR,1
        SRM R0,[R13+72]
        FileField 120
        FileSmall 512
        Call core_clear
        ADI SP,SP,8
        FileSmall 1
        Call file_sector
        ADI SP,SP,4
        SRZ R0
        JMP file_io_fault
        LRM R0,[R13+32]
        LRM R0,[R0+36]
        ADI R1,RZR,2
        SUB R1,R0,R1
        SNZ R1
        JMP file_cluster_zero_done
        ADI R0,RZR,1
        SRM R0,[R13+76]
        FileSmall 1
        Call file_sector
        ADI SP,SP,4
        SRZ R0
        JMP file_io_fault
        SRM RZR,[R13+76]
file_cluster_zero_done:
file_chunk:
        ADI R0,RZR,512
        LRM R1,[R13+60]
        SUB R0,R0,R1
        LRM R1,[R13+44]
        LRM R2,[R13+52]
        SUB R1,R1,R2
        SUB R2,R1,R0
        Const R3,80000000h
        ANL R2,R2,R3
        SRZ R2
        ADD R0,R1,RZR
        SRM R0,[R13+68]
        LRM R1,[R13+60]
        ADD R1,R1,R1
        ADD R1,R1,R1
        LRM R2,[R13+120]
        ADD R1,R1,R2
        LRM R2,[R13+52]
        ADD R2,R2,R2
        ADD R2,R2,R2
        LRM R3,[R13+48]
        ADD R2,R2,R3
        LRM R3,[R13+112]
        ADI R3,R3,-23h
        SNZ R3
        JMP file_copy_write
        PSH R2
        PSH R1
        PSH R0
        Call core_memcopy
        ADI SP,SP,12
        JMP file_advance
file_copy_write:
        PSH R1
        PSH R2
        PSH R0
        Call core_memcopy
        ADI SP,SP,12
        FileSmall 1
        Call file_sector
        ADI SP,SP,4
        SRZ R0
        JMP file_io_fault
        LRM R0,[R13+72]
        SNZ R0
        JMP file_write_header
        LRM R0,[R13+40]
        SNZ R0
        JMP file_first_cluster
        ADI R0,R0,-1
        ADD R0,R0,R0
        ADD R0,R0,R0
        LRM R1,[R13+124]
        ADD R0,R0,R1
        LRM R0,[R0]
        PSH R0
        FileField 64
        Call core_fatset
        ADI SP,SP,8
        JMP file_linked
file_first_cluster:
        LRM R0,[R13+64]
        SRM R0,[R13+28]
file_linked:
        Call core_fatflush
        SRZ R0
        JMP file_io_fault
        LRM R0,[R13+40]
        ADD R0,R0,R0
        ADD R0,R0,R0
        LRM R1,[R13+124]
        ADD R0,R0,R1
        LRM R1,[R13+64]
        SRM R1,[R0]
        LRM R0,[R13+40]
        ADI R0,R0,1
        SRM R0,[R13+40]
file_write_header:
        LRM R0,[R13+24]
        LRM R1,[R13+68]
        ADD R0,R0,R1
        LRM R1,[R13+20]
        SUB R2,R0,R1
        Const R3,80000000h
        ANL R2,R2,R3
        SRZ R2
        JMP file_header_ready
        SRM R0,[R13+20]
file_header_ready:
        Call file_commit
        SRZ R0
        JMP file_io_fault
file_advance:
        LRM R0,[R13+24]
        LRM R1,[R13+68]
        ADD R0,R0,R1
        SRM R0,[R13+24]
        LRM R0,[R13+52]
        ADD R0,R0,R1
        SRM R0,[R13+52]
        Call file_store
        JMP file_io_loop
file_io_success:
        ADI R0,RZR,0
        JMP file_io_result
file_io_denied:
        ADI R0,RZR,5
        JMP file_io_result
file_io_parameter:
        ADI R0,RZR,87
        JMP file_io_result
file_io_data:
        ADI R0,RZR,13
        JMP file_io_fault
file_io_disk_error:
        Const R0,13fe4h
        LRM R0,[R0]
        JMP file_io_result
file_io_fault:
        LRM R1,[R13]
        SRM RZR,[R1]
file_io_result:
        LRM R1,[R13+52]
        SRM R1,[RZR+4d04h]
        JMP file_result
file_close:
        Call file_find
        SRZ R0
        JMP file_open_error
        LRM R1,[R13]
        SRM RZR,[R1]
        ADI R0,RZR,0
        JMP file_result
file_open:
        LRM R0,[RZR+4d08h]
        SRM R0,[R13+4]
        ADI R1,RZR,3
        SUB R1,R0,R1
        Const R2,80000000h
        ANL R3,R0,R2
        SRZ R3
        JMP file_open_parameter
        ANL R1,R1,R2
        SNZ R1
        JMP file_open_parameter
        ADI R3,RZR,63
        Call syscall_text
        SRZ R0
        JMP file_open_error
        LRM R8,[RZR+4d04h]
file_path_check:
        LRM R0,[R8]
        SNZ R0
        JMP file_open_slot
        ADI R1,R0,-32
        SNZ R1
        JMP file_open_parameter
        ADI R1,R0,-9
        SNZ R1
        JMP file_open_parameter
        ADI R8,R8,4
        JMP file_path_check
file_open_slot:
        Const R8,0xB0000
        ADI R9,RZR,1
file_slot_scan:
        LRM R0,[R8]
        SNZ R0
        JMP file_slot_found
        ADI R8,R8,128
        ADI R9,R9,1
        ADI R0,R9,-9
        SRZ R0
        JMP file_slot_scan
        ADI R0,RZR,4
        JMP file_open_error
file_slot_found:
        SRM R8,[R13]
        SRM R9,[R13+80]
        LRM R0,[RZR+4d04h]
        PSH R0
        LRM R0,[R13+4]
        ADI R0,R0,-1
        ADI R1,RZR,0
        SNZ R0
        ADI R1,RZR,1
        PSH R1
        Call core_resolve
        ADI SP,SP,8
        SRZ R0
        JMP file_open_error
        Const R0,13fcch
        LRM R0,[R0]
        SRZ R0
        JMP file_open_denied
        Const R0,13fe0h
        LRM R0,[R0]
        SRM R0,[R13+32]
        LRM R0,[R0]
        SRM R0,[R13+8]
        Const R0,13fc4h
        LRM R0,[R0]
        SRM R0,[R13+36]
        SNZ R0
        JMP file_open_create
        LRM R1,[R0+44]
        ADI R2,RZR,24
        ANL R2,R1,R2
        SRZ R2
        JMP file_open_denied
        LRM R2,[R13+4]
        SNZ R2
        JMP file_open_location
        ADI R2,RZR,1
        ANL R1,R1,R2
        SRZ R1
        JMP file_open_denied
file_open_location:
        Const R1,13ff8h
        LRM R1,[R1]
        SRM R1,[R13+12]
        LRM R1,[R13+116]
        SUB R0,R0,R1
        SRM R0,[R13+16]
        Call file_duplicate
        SRZ R0
        JMP file_open_error
        LRM R0,[R13+36]
        ADI R0,R0,104
        PSH R0
        Call core_le16
        ADI SP,SP,4
        SRM R0,[R13+28]
        LRM R0,[R13+36]
        ADI R0,R0,112
        PSH R0
        Call core_le32
        ADI SP,SP,4
        SRM R0,[R13+20]
        Call file_chain
        SRZ R0
        JMP file_open_error
        LRM R0,[R13+4]
        ADI R0,R0,-1
        SNZ R0
        JMP file_open_truncate
        JMP file_open_ready
file_open_create:
        Const R0,13fc0h
        LRM R0,[R0]
        PSH R0
        Call core_free_entry
        ADI SP,SP,4
        SNZ R0
        JMP file_open_disk_error
        SRM R0,[R13+36]
        Const R1,13ff8h
        LRM R1,[R1]
        SRM R1,[R13+12]
        LRM R1,[R13+116]
        SUB R0,R0,R1
        SRM R0,[R13+16]
        FileField 36
        FileSmall 32
        Call core_clear
        ADI SP,SP,8
        FileField 36
        ExecArg 14800h
        FileSmall 11
        Call core_memcopy
        ADI SP,SP,12
        SRM RZR,[R13+40]
file_open_truncate:
        SRM RZR,[R13+20]
        SRM RZR,[R13+28]
        Call file_commit
        SRZ R0
        JMP file_open_error
        FileField 124
        FileField 40
        Call core_free_chain
        ADI SP,SP,8
        Call core_fatflush
        SRZ R0
        JMP file_open_error
file_open_ready:
        SRM RZR,[R13+24]
        Call file_store
        LRM R0,[R13]
        ADI R1,RZR,1
        SRM R1,[R0]
        ADI R0,R0,32
        PSH R0
        FileField 36
        FileSmall 11
        Call core_memcopy
        ADI SP,SP,12
        LRM R0,[R13+80]
        SRM R0,[RZR+4d04h]
        ADI R0,RZR,0
        JMP file_result
file_open_parameter:
        ADI R0,RZR,87
        JMP file_open_error
file_open_denied:
        ADI R0,RZR,5
        JMP file_open_error
file_open_disk_error:
        Const R0,13fe4h
        LRM R0,[R0]
        SNZ R0
        ADI R0,RZR,112
file_open_error:
        SRM RZR,[RZR+4d04h]
file_result:
        SRZ R0
        JMP file_result_error
        JMP syscall_result
file_result_error:
        Const R1,13ff4h
        ADI R2,RZR,-1
        SRM R2,[R1]
        SRM R2,[R1+4]
        JMP syscall_result

; Helpers use the normal native Call/return convention and preserve R13.
file_find:
        LRM R0,[RZR+4d04h]
        ADI R0,R0,-1
        Const R1,80000000h
        ANL R2,R0,R1
        SRZ R2
        JMP file_invalid
        ADI R2,R0,-8
        ANL R2,R2,R1
        SNZ R2
        JMP file_invalid
        REPT 7
        ADD R0,R0,R0
        ENDM
        Const R8,0xB0000
        ADD R8,R8,R0
        LRM R0,[R8]
        SNZ R0
        JMP file_invalid
        SRM R8,[R13]
        ADI R8,R8,4
        ADI R9,R13,4
        ADI R3,RZR,7
file_find_copy:
        LRM R0,[R8]
        SRM R0,[R9]
        ADI R8,R8,4
        ADI R9,R9,4
        ADI R3,R3,-1
        SRZ R3
        JMP file_find_copy
        ADI R0,RZR,0
        JMP return_sub
file_invalid:
        ADI R0,RZR,6
        JMP return_sub
file_store:
        ADI R8,R13,4
        LRM R9,[R13]
        ADI R9,R9,4
        ADI R3,RZR,7
file_store_loop:
        LRM R0,[R8]
        SRM R0,[R9]
        ADI R8,R8,4
        ADI R9,R9,4
        ADI R3,R3,-1
        SRZ R3
        JMP file_store_loop
        ADI R0,RZR,0
        JMP return_sub
file_duplicate:
        Const R8,0xB0000
        ADI R9,RZR,8
file_duplicate_loop:
        LRM R0,[R8]
        SNZ R0
        JMP file_duplicate_next
        LRM R0,[R8+8]
        LRM R1,[R13+8]
        SUB R0,R0,R1
        SRZ R0
        JMP file_duplicate_next
        LRM R0,[R8+12]
        LRM R1,[R13+12]
        SUB R0,R0,R1
        SRZ R0
        JMP file_duplicate_next
        LRM R0,[R8+16]
        LRM R1,[R13+16]
        SUB R0,R0,R1
        SRZ R0
        JMP file_duplicate_next
        ADI R0,RZR,5
        JMP return_sub
file_duplicate_next:
        ADI R8,R8,128
        ADI R9,R9,-1
        SRZ R9
        JMP file_duplicate_loop
        ADI R0,RZR,0
        JMP return_sub
file_load:
        FileField 8
        Call core_select
        ADI SP,SP,4
        SRZ R0
        JMP return_sub
        Const R0,13fe0h
        LRM R0,[R0]
        SRM R0,[R13+32]
        FileField 12
        Call core_read_dir_sector
        ADI SP,SP,4
        SRZ R0
        JMP return_sub
        LRM R8,[R13+116]
        LRM R0,[R13+16]
        ADD R8,R8,R0
        SRM R8,[R13+36]
        LRM R9,[R13]
        ADI R9,R9,32
        ADI R3,RZR,11
file_name_loop:
        LRM R0,[R8]
        LRM R1,[R9]
        SUB R0,R0,R1
        SRZ R0
        JMP file_stale
        ADI R8,R8,4
        ADI R9,R9,4
        ADI R3,R3,-1
        SRZ R3
        JMP file_name_loop
        LRM R0,[R13+36]
        ADI R0,R0,104
        PSH R0
        Call core_le16
        ADI SP,SP,4
        LRM R1,[R13+28]
        SUB R0,R0,R1
        SRZ R0
        JMP file_stale
        LRM R0,[R13+36]
        ADI R0,R0,112
        PSH R0
        Call core_le32
        ADI SP,SP,4
        LRM R1,[R13+20]
        SUB R0,R0,R1
        SRZ R0
        JMP file_stale
        Call file_chain
        JMP return_sub
file_stale:
        LRM R1,[R13]
        SRM RZR,[R1]
        JMP file_invalid
file_chain:
        FileField 28
        FileField 20
        FileField 124
        Call core_chain_load
        ADI SP,SP,12
        Const R1,80000000h
        ANL R1,R0,R1
        SRZ R1
        JMP file_helper_disk_error
        SRM R0,[R13+40]
        LRM R0,[R13+32]
        LRM R0,[R0+36]
        ADI R1,RZR,512
        Call core_mul
        PSH R0
        ADI R0,R0,-1
        PSH R0
        LRM R0,[R13+20]
        POP R1
        ADD R0,R0,R1
        POP R1
        Call core_div
        LRM R1,[R13+40]
        SUB R0,R0,R1
        SRZ R0
        JMP file_helper_data
        ADI R0,RZR,0
        JMP return_sub
file_helper_disk_error:
        Const R0,13fe4h
        LRM R0,[R0]
        JMP return_sub
file_helper_data:
        ADI R0,RZR,13
        JMP return_sub
file_commit:
        FileField 12
        Call core_read_dir_sector
        ADI SP,SP,4
        SRZ R0
        JMP return_sub
        LRM R0,[R13+116]
        LRM R1,[R13+16]
        ADD R0,R0,R1
        SRM R0,[R13+36]
        ADI R0,R0,104
        PSH R0
        FileField 28
        Call core_set16
        ADI SP,SP,8
        LRM R0,[R13+36]
        ADI R0,R0,112
        PSH R0
        FileField 20
        Call core_set32
        ADI SP,SP,8
        LRM R0,[R13+36]
        LRM R1,[R0+44]
        ADI R2,RZR,32
        ORR R1,R1,R2
        SRM R1,[R0+44]
        FileField 12
        FileField 116
        FileField 8
        FileSmall 1
        Call core_block
        ADI SP,SP,16
        JMP return_sub
file_sector:
        LRM R0,[R13+32]
        LRM R0,[R0+28]
        PSH R0
        LRM R0,[R13+32]
        LRM R0,[R0+36]
        LRM R1,[R13+64]
        ADI R1,R1,-2
        Call core_mul
        ADD R1,R0,RZR
        POP R0
        ADD R0,R0,R1
        LRM R1,[R13+76]
        ADD R0,R0,R1
        PSH R0
        FileField 120
        FileField 8
        LRM R0,[SP+16]
        PSH R0
        Call core_block
        ADI SP,SP,16
        JMP return_sub
file_buffer:
        LRM R8,[R13+48]
        LRM R9,[R13+44]
        Const R4,80000000h
        ANL R0,R8,R4
        SRZ R0
        JMP file_helper_parameter
        ANL R0,R9,R4
        SRZ R0
        JMP file_helper_parameter
        Const R0,32769
        SUB R0,R9,R0
        ANL R0,R0,R4
        SNZ R0
        JMP file_helper_parameter
        ADI R0,RZR,3
        ANL R0,R8,R0
        SRZ R0
        JMP file_helper_parameter
        Const R0,80000h
        SUB R0,R8,R0
        ANL R0,R0,R4
        SRZ R0
        JMP file_helper_parameter
        Const R3,8fff0h
        SUB R0,R8,R3
        ANL R0,R0,R4
        SNZ R0
        JMP file_buffer_work
        JMP file_buffer_end
file_buffer_work:
        Const R0,0d0000h
        SUB R0,R8,R0
        ANL R0,R0,R4
        SRZ R0
        JMP file_helper_parameter
        Const R3,0f0000h
        SUB R0,R8,R3
        ANL R0,R0,R4
        SNZ R0
        JMP file_buffer_args
        JMP file_buffer_end
file_buffer_args:
        Const R0,0f1000h
        SUB R0,R8,R0
