; Memory ownership (all addresses physical, DS/SS/ES=0):
; D0000..D7FFF source (8192 word bytes, no sentinel beyond this range).
; D8000..D97FF symbols: 256 records of six words (source,len,kind,value,argc,scope).
; D9800..D9FFF state, paths, decimal and token scratch.
; DA000..DDFFF line runs: 2048 (generated byte offset, source line) pairs.
; DE000..DFFFF streaming I/O. 90000..9FFEF generated packed words.
; E0000..EFFFF compiler stack. Generated programs own D0000..D03FF globals
; and E0000..EFFFF frames; they never depend on compiler state.
D_SOURCE EQU 0d0000h
D_SYMBOL EQU 0d8000h
D_STATE EQU 0d9800h
D_LINES EQU 0da000h
D_BUFFER EQU 0de000h
D_INPUT EQU 0d9a00h
D_OUTPUT EQU 0d9b00h
D_TEMP EQU 0d9c00h
D_MOVE EQU 0d9d00h
D_NUMBER EQU 0d9f00h
d_pos EQU 0
d_end EQU 4
d_line EQU 8
d_tokline EQU 12
d_token EQU 16
d_text EQU 20
d_length EQU 24
d_value EQU 28
d_symbols EQU 32
d_scope EQU 36
d_globals EQU 40
d_locals EQU 44
d_params EQU 48
d_depth EQU 52
d_loop EQU 56
d_breaks EQU 60
d_size EQU 64
d_runs EQU 68
d_lastline EQU 72
d_mode EQU 76
d_handle EQU 80
d_initialsp EQU 84
d_outputptr EQU 88
d_outputcount EQU 92
d_transfer EQU 96
d_listingrun EQU 112
d_listingline EQU 116
d_savederror EQU 120
d_owned EQU 124
T_ID EQU 256
T_INT EQU 257
T_STR EQU 258
T_ASSIGN EQU 259
T_LE EQU 260
T_GE EQU 261
T_NE EQU 262
T_PROGRAM EQU 270
T_FUNCTION EQU 271
T_BEGIN EQU 272
T_END EQU 273
T_VAR EQU 274
T_IF EQU 275
T_THEN EQU 276
T_ELSE EQU 277
T_WHILE EQU 278
T_DO EQU 279
T_WRITE EQU 280
T_WRITELN EQU 281
T_GET EQU 282
T_CONTINUE EQU 283
T_BREAK EQU 284
DAddr MACRO reg,label
        TrConst reg,80000h+label
        ENDM
DGet MACRO reg,field
        LRM reg,[R13+field]
        ENDM
DPut MACRO reg,field
        SRM reg,[R13+field]
        ENDM
DSet MACRO field,value
        TrConst R0,value
        DPut R0,field
        ENDM
DEq MACRO reg,value,target
        TrConst R1,value
        SUB R1,reg,R1
        SNZ R1
        JMP target
        ENDM
DNe MACRO reg,value,target
        TrConst R1,value
        SUB R1,reg,R1
        SRZ R1
        JMP target
        ENDM
DLt MACRO left,right,target
        SUB R0,left,right
        TrConst R1,80000000h
        ANL R0,R0,R1
        SRZ R0
        JMP target
        ENDM
DBegin MACRO
        PSH R6
        PSH R8
        PSH R9
        PSH R10
        PSH R11
        ENDM
DExpect MACRO token
        ADI R2,RZR,token
        TrCall d_expect
        ENDM
DEmit MACRO word
        TrConst R2,word
        TrCall d_emit
        ENDM
DSeq MACRO label,count
        DAddr R2,label
        ADI R3,RZR,count
        TrCall d_words
        ENDM
DSay MACRO label
        DAddr R2,label
        TrCall tr_puts
        ENDM
d_return:
        POP R11
        POP R10
        POP R9
        POP R8
        POP R6
        JMP tr_return

; Read-only ASCII case folding; string literal bytes never pass through here.
d_upper:
        ADI R0,R2,-97
        TrConst R1,80000000h
        ANL R0,R0,R1
        SRZ R0
        JMP tr_return
        ADI R0,R2,-123
        ANL R0,R0,R1
        SNZ R0
        JMP tr_return
        ADI R2,R2,-32
        JMP tr_return
; R2 byte -> R2 true iff ASCII letter or digit. R0/R1 volatile.
d_alnum:
        TrCall d_upper
        ADI R0,R2,-65
        TrConst R1,80000000h
        ANL R0,R0,R1
        SRZ R0
        JMP d_alnum_digit
        ADI R0,R2,-91
        ANL R0,R0,R1
        SRZ R0
        JMP d_alnum_yes
d_alnum_digit:
        ADI R0,R2,-48
        ANL R0,R0,R1
        SRZ R0
        JMP d_alnum_no
        ADI R0,R2,-58
        ANL R0,R0,R1
        SRZ R0
        JMP d_alnum_yes
d_alnum_no:
        ADI R2,RZR,0
        JMP tr_return
d_alnum_yes:
        ADI R2,RZR,1
        JMP tr_return

; Bounded lookahead. EOF is 0; embedded NUL is diagnosed at load time.
d_peek:
        DGet R3,d_pos
        DGet R2,d_end
        SUB R2,R3,R2
        SNZ R2
        JMP tr_return
        LRM R2,[R3]
        JMP tr_return
d_advance:
        DGet R3,d_pos
        DGet R2,d_end
        SUB R2,R3,R2
        SNZ R2
        JMP tr_return
        LRM R2,[R3]
        ADI R3,R3,4
        DPut R3,d_pos
        DEq R2,10,d_advance_line
        JMP tr_return
d_advance_line:
        DGet R2,d_line
        ADI R2,R2,1
        DPut R2,d_line
        JMP tr_return

; Token offsets point into the immutable loaded source. Keywords are table-driven.
d_next:
        DBegin
d_next_skip:
        TrCall d_peek
        DEq R2,0,d_next_eof
        DEq R2,26,d_next_eof
        DEq R2,35,d_next_comment
        ADI R3,RZR,33
        DLt R2,R3,d_next_space
        DGet R8,d_pos
        DPut R8,d_text
        DGet R9,d_line
        DPut R9,d_tokline
        DEq R2,34,d_next_string
        TrCall d_upper
        ADD R9,R2,RZR
        ADI R3,RZR,65
        DLt R9,R3,d_next_number_test
        ADI R3,RZR,91
        DLt R9,R3,d_next_identifier
d_next_number_test:
        ADI R3,RZR,48
        DLt R9,R3,d_next_punctuation
        ADI R3,RZR,58
        DLt R9,R3,d_next_number
        JMP d_next_punctuation
d_next_space:
        TrCall d_advance
        JMP d_next_skip
d_next_comment:
        TrCall d_advance
        TrCall d_peek
        DEq R2,0,d_next_skip
        DEq R2,26,d_next_skip
        DNe R2,10,d_next_comment
        JMP d_next_skip
d_next_eof:
        DSet d_token,0
        DGet R2,d_line
        DPut R2,d_tokline
        JMP d_return
d_next_identifier:
        ADI R9,RZR,0
d_next_id_loop:
        TrCall d_advance
        ADI R9,R9,1
        DEq R9,32,d_limit
        TrCall d_peek
        TrCall d_alnum
        DNe R2,0,d_next_id_loop
        DPut R9,d_length
        DSet d_token,T_ID
        DAddr R10,d_keywords
        ADI R11,RZR,T_PROGRAM
d_next_keyword:
        LRM R6,[R10]
        DEq R6,0,d_return
        ADI R10,R10,4
        SUB R0,R6,R9
        SRZ R0
        JMP d_next_keyword_skip
        ADD R2,R8,RZR
        ADD R3,R10,RZR
        ADD R4,R9,RZR
        TrCall d_equal_name
        DEq R2,1,d_next_keyword_found
d_next_keyword_skip:
        ADD R6,R6,R6
        ADD R6,R6,R6
        ADD R10,R10,R6
        ADI R11,R11,1
        JMP d_next_keyword
d_next_keyword_found:
        DPut R11,d_token
        JMP d_return
d_next_number:
        ADI R9,RZR,0
d_next_num_loop:
        TrCall d_peek
        ADI R2,R2,-48
        ADD R3,R9,R9
        ADD R9,R3,R3
        ADD R9,R9,R9
        ADD R9,R9,R3
        ADD R9,R9,R2
        TrConst R3,0ffffh
        ANL R9,R9,R3
        TrCall d_advance
        TrCall d_peek
        ADI R3,RZR,48
        DLt R2,R3,d_next_num_done
        ADI R3,RZR,58
        DLt R2,R3,d_next_num_loop
d_next_num_done:
        DPut R9,d_value
        DSet d_token,T_INT
        JMP d_return
d_next_string:
        TrCall d_advance
        DGet R8,d_pos
        DPut R8,d_text
        ADI R9,RZR,0
d_next_str_loop:
        TrCall d_peek
        DEq R2,0,d_string_error
        DEq R2,26,d_string_error
        DEq R2,10,d_string_error
        DEq R2,13,d_string_error
        DEq R2,34,d_next_str_done
        ADI R9,R9,1
        TrCall d_advance
        JMP d_next_str_loop
d_next_str_done:
        DPut R9,d_length
        DSet d_token,T_STR
        TrCall d_advance
        JMP d_return
d_next_punctuation:
        ADD R9,R2,RZR
        TrCall d_advance
        TrCall d_peek
        DEq R9,58,d_next_colon
        DEq R9,60,d_next_less
        DEq R9,62,d_next_greater
        JMP d_next_punct_done
d_next_colon:
        DNe R2,61,d_syntax
        ADI R9,RZR,T_ASSIGN
        JMP d_next_double
d_next_less:
        DEq R2,61,d_next_le
        DEq R2,62,d_next_ne
        JMP d_next_punct_done
d_next_greater:
        DNe R2,61,d_next_punct_done
        ADI R9,RZR,T_GE
        JMP d_next_double
d_next_le:
        ADI R9,RZR,T_LE
        JMP d_next_double
d_next_ne:
        ADI R9,RZR,T_NE
d_next_double:
        TrCall d_advance
d_next_punct_done:
        DPut R9,d_token
        JMP d_return

; R2 source word bytes, R3 other word bytes, R4 length -> R2 equal (0/1).
; Compare exactly length bytes; callers check lengths before comparing symbols.
d_equal_name:
        DBegin
        ADD R8,R2,RZR
        ADD R9,R3,RZR
        ADD R6,R4,RZR
d_equal_loop:
        DEq R6,0,d_equal_yes
        LRM R2,[R8]
        TrCall d_upper
        ADD R10,R2,RZR
        LRM R2,[R9]
        TrCall d_upper
        SUB R0,R10,R2
        SRZ R0
        JMP d_equal_no
        ADI R8,R8,4
        ADI R9,R9,4
        ADI R6,R6,-1
        JMP d_equal_loop
d_equal_yes:
        ADI R2,RZR,1
        JMP d_return
d_equal_no:
        ADI R2,RZR,0
        JMP d_return

d_expect:
        DGet R3,d_token
        SUB R0,R3,R2
        SRZ R0
        JMP d_syntax
        JMP d_next
d_enter:
        DGet R2,d_depth
        ADI R2,R2,1
        DEq R2,33,d_limit
        DPut R2,d_depth
        JMP tr_return
d_leave:
        DGet R2,d_depth
        ADI R2,R2,-1
        DPut R2,d_depth
        JMP tr_return

; Lookup prefers the current function scope; global scope is the fallback.
; R2=record pointer or zero. RESULT is a synthetic local record in each function.
d_lookup:
        DBegin
        DGet R6,d_symbols
        DGet R11,d_scope
        TrConst R8,D_SYMBOL
        ADI R9,RZR,0
d_lookup_loop:
        DEq R6,0,d_lookup_done
        LRM R10,[R8+4]
        DGet R2,d_length
        SUB R0,R10,R2
        SRZ R0
        JMP d_lookup_next
        LRM R10,[R8+20]
        DEq R10,0,d_lookup_compare
        SUB R0,R10,R11
        SRZ R0
        JMP d_lookup_next
d_lookup_compare:
        DGet R2,d_text
        LRM R3,[R8]
        DGet R4,d_length
        TrCall d_equal_name
        DEq R2,0,d_lookup_next
        ADD R9,R8,RZR
        LRM R10,[R8+20]
        DNe R10,0,d_lookup_done
d_lookup_next:
        ADI R8,R8,24
        ADI R6,R6,-1
        JMP d_lookup_loop
d_lookup_done:
        ADD R2,R9,RZR
        JMP d_return

; Add current identifier: R2 kind, R3 value; current scope. R2 new record.
d_add:
        DBegin
        ADD R8,R2,RZR
        ADD R9,R3,RZR
        DGet R6,d_token
        DNe R6,T_ID,d_syntax
        TrCall d_lookup
        DEq R2,0,d_add_unique
        LRM R3,[R2+20]
        DGet R6,d_scope
        SUB R0,R3,R6
        SNZ R0
        JMP d_duplicate
        ; A local may shadow a global variable or an earlier function, but not itself.
        SUB R0,R2,R6
        SNZ R0
        JMP d_duplicate
d_add_unique:
        DGet R6,d_symbols
        DEq R6,256,d_limit
        ADD R2,R6,R6
        ADD R2,R2,R6
        REPT 3
        ADD R2,R2,R2
        ENDM
        TrConst R3,D_SYMBOL
        ADD R2,R2,R3
        DGet R3,d_text
        SRM R3,[R2]
        DGet R3,d_length
        SRM R3,[R2+4]
        SRM R8,[R2+8]
        SRM R9,[R2+12]
        SRM RZR,[R2+16]
        DGet R3,d_scope
        SRM R3,[R2+20]
        ADI R6,R6,1
        DPut R6,d_symbols
        JMP d_return

d_keywords:
        DD 7,80,82,79,71,82,65,77
        DD 8,70,85,78,67,84,73,79,78
        DD 5,66,69,71,73,78
        DD 3,69,78,68
        DD 3,86,65,82
        DD 2,73,70
        DD 4,84,72,69,78
        DD 4,69,76,83,69
        DD 5,87,72,73,76,69
        DD 2,68,79
        DD 5,87,82,73,84,69
        DD 7,87,82,73,84,69,76,78
        DD 3,71,69,84
        DD 8,67,79,78,84,73,78,85,69
        DD 5,66,82,69,65,75
        DD 0
d_result_name: DD 82,69,83,85,76,84
