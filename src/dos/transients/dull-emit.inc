; R2 instruction/data word -> R2 generated byte offset. Max 65520 bytes.
; Source line runs include runtime=0 and are retained for /L.
d_emit:
        DBegin
        ADD R8,R2,RZR
        DGet R9,d_size
        TrConst R10,65520
        DLt R9,R10,d_emit_room
        JMP d_limit
d_emit_room:
        DGet R10,d_tokline
        DGet R11,d_lastline
        SUB R0,R10,R11
        SNZ R0
        JMP d_emit_store
        DGet R6,d_runs
        DEq R6,2048,d_limit
        ADD R2,R6,R6
        ADD R2,R2,R2
        ADD R2,R2,R2
        TrConst R3,D_LINES
        ADD R2,R2,R3
        SRM R9,[R2]
        SRM R10,[R2+4]
        ADI R6,R6,1
        DPut R6,d_runs
        DPut R10,d_lastline
d_emit_store:
        TrConst R2,90000h
        ADD R2,R2,R9
        SRM R8,[R2]
        ADD R2,R9,RZR
        ADI R9,R9,4
        DPut R9,d_size
        JMP d_return

; Copy a sequence of R3 packed native words from physical R2.
d_words:
        DBegin
        ADD R8,R2,RZR
        ADD R9,R3,RZR
d_words_loop:
        DEq R9,0,d_return
        LRM R2,[R8]
        TrCall d_emit
        ADI R8,R8,4
        ADI R9,R9,-1
        JMP d_words_loop

; R2 value, R3 destination register (0..14). Inline literal: LRM/JMP/DD.
d_constant:
        DBegin
        ADD R8,R2,RZR
        DGet R9,d_size
        ADI R2,R9,8-32768
        TrConst R4,0ffffh
        ANL R2,R2,R4
        REPT 21
        ADD R3,R3,R3
        ENDM
        TrConst R4,040c0000h
        ORR R3,R3,R4
        ORR R2,R2,R3
        TrCall d_emit
        DEmit 18000002h
        ADD R2,R8,RZR
        TrCall d_emit
        JMP d_return

; R2 destination offset, R3 instruction offset -> R2 relative JMP word.
; Unsigned division followed by the 21-bit field mask handles negative deltas.
d_jumpword:
        DBegin
        SUB R0,R2,R3
        ADI R1,RZR,4
        TrCall tr_div
        TrConst R2,01fffffh
        ANL R2,R0,R2
        TrConst R3,18000000h
        ORR R2,R2,R3
        JMP d_return
d_jump:
        DBegin
        DGet R3,d_size
        TrCall d_jumpword
        TrCall d_emit
        JMP d_return
; R2 patch offset, R3 destination. This never changes the recorded source line.
d_patch:
        DBegin
        ADD R8,R2,RZR
        ADD R2,R3,RZR
        ADD R3,R8,RZR
        TrCall d_jumpword
        TrConst R3,90000h
        ADD R3,R3,R8
        SRM R2,[R3]
        JMP d_return

; Calls use a native relative return instruction on the ordinary E stack.
d_call:
        DBegin
        ADD R8,R2,RZR
        DGet R2,d_size
        ADI R2,R2,20
        ADI R3,RZR,rt_return_slot-rt_base
        TrCall d_jumpword
        ADI R3,RZR,7
        TrCall d_constant
        DEmit 0ce00000h
        ADD R2,R8,RZR
        TrCall d_jump
        JMP d_return

DRun MACRO label
        ADI R2,RZR,label-rt_base
        TrCall d_call
        ENDM
DRunTail MACRO label
        ADI R2,RZR,label-rt_base
        TrCall d_jump
        ENDM

; Copy the complete runtime once. Internal relocations use offsets from rt_base.
d_runtime:
        DBegin
        DSet d_tokline,0
        DSet d_lastline,-1
        DAddr R2,rt_base
        ADI R3,RZR,(rt_end-rt_base)/4
        TrCall d_words
        JMP d_return
        INCLUDE dull-ops.inc
